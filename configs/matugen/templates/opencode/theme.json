{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "m-primary": "{{colors.primary.dark.hex}}",
    "m-primary-bright": "{{colors.primary.light.hex}}",
    "m-secondary": "{{colors.secondary.dark.hex}}",
    "m-secondary-bright": "{{colors.secondary.light.hex}}",
    "m-tertiary": "{{colors.tertiary.dark.hex}}",
    "m-tertiary-bright": "{{colors.tertiary.light.hex}}",
    "m-error": "{{colors.error.dark.hex}}",
    "m-error-bright": "{{colors.error.light.hex}}",
    "m-error-container": "{{colors.error_container.dark.hex}}",
    "m-error-container-bright": "{{colors.error_container.light.hex}}",
    "m-primary-container": "{{colors.primary_container.dark.hex}}",
    "m-primary-container-bright": "{{colors.primary_container.light.hex}}",
    "m-secondary-container": "{{colors.secondary_container.dark.hex}}",
    "m-secondary-container-bright": "{{colors.secondary_container.light.hex}}",
    "m-tertiary-container": "{{colors.tertiary_container.dark.hex}}",
    "m-tertiary-container-bright": "{{colors.tertiary_container.light.hex}}",
    "m-on-surface": "{{colors.on_surface.dark.hex}}",
    "m-on-surface-bright": "{{colors.on_surface.light.hex}}",
    "m-on-surface-variant": "{{colors.on_surface_variant.dark.hex}}",
    "m-on-surface-variant-bright": "{{colors.on_surface_variant.light.hex}}",
    "m-surface": "{{colors.surface.dark.hex}}",
    "m-surface-bright": "{{colors.surface.light.hex}}",
    "m-surface-container": "{{colors.surface_container.dark.hex}}",
    "m-surface-container-bright": "{{colors.surface_container.light.hex}}",
    "m-surface-container-low": "{{colors.surface_container_low.dark.hex}}",
    "m-surface-container-low-bright": "{{colors.surface_container_low.light.hex}}",
    "m-surface-container-high": "{{colors.surface_container_high.dark.hex}}",
    "m-surface-container-high-bright": "{{colors.surface_container_high.light.hex}}",
    "m-surface-variant": "{{colors.surface_variant.dark.hex}}",
    "m-surface-variant-bright": "{{colors.surface_variant.light.hex}}",
    "m-outline": "{{colors.outline.dark.hex}}",
    "m-outline-bright": "{{colors.outline.light.hex}}",
    "m-outline-variant": "{{colors.outline_variant.dark.hex}}",
    "m-outline-variant-bright": "{{colors.outline_variant.light.hex}}"
  },
  "theme": {
    "primary": {
      "dark": "m-primary",
      "light": "m-primary-bright"
    },
    "secondary": {
      "dark": "m-secondary",
      "light": "m-secondary-bright"
    },
    "accent": {
      "dark": "m-tertiary",
      "light": "m-tertiary-bright"
    },
    "error": {
      "dark": "m-error",
      "light": "m-error-bright"
    },
    "warning": {
      "dark": "m-error-container",
      "light": "m-error-container-bright"
    },
    "success": {
      "dark": "m-secondary-container",
      "light": "m-secondary-container-bright"
    },
    "info": {
      "dark": "m-primary-container",
      "light": "m-primary-container-bright"
    },
    "text": {
      "dark": "m-on-surface",
      "light": "m-on-surface-bright"
    },
    "textMuted": {
      "dark": "m-on-surface-variant",
      "light": "m-on-surface-variant-bright"
    },
    "background": {
      "dark": "m-surface",
      "light": "m-surface-bright"
    },
    "backgroundPanel": {
      "dark": "m-surface-container",
      "light": "m-surface-container-bright"
    },
    "backgroundElement": {
      "dark": "m-surface-container-low",
      "light": "m-surface-container-low-bright"
    },
    "border": {
      "dark": "m-outline-variant",
      "light": "m-outline-variant-bright"
    },
    "borderActive": {
      "dark": "m-outline",
      "light": "m-outline-bright"
    },
    "borderSubtle": {
      "dark": "m-surface-variant",
      "light": "m-surface-variant-bright"
    },
    "diffAdded": {
      "dark": "m-secondary",
      "light": "m-secondary-bright"
    },
    "diffRemoved": {
      "dark": "m-error",
      "light": "m-error-bright"
    },
    "diffContext": {
      "dark": "m-surface-container-high",
      "light": "m-surface-container-high-bright"
    },
    "diffHunkHeader": {
      "dark": "m-surface-variant",
      "light": "m-surface-variant-bright"
    },
    "diffHighlightAdded": {
      "dark": "m-secondary-container",
      "light": "m-secondary-container-bright"
    },
    "diffHighlightRemoved": {
      "dark": "m-error-container",
      "light": "m-error-container-bright"
    },
    "diffAddedBg": {
      "dark": "m-surface-container-low",
      "light": "m-surface-container-low-bright"
    },
    "diffRemovedBg": {
      "dark": "m-surface-container-low",
      "light": "m-surface-container-low-bright"
    },
    "diffContextBg": {
      "dark": "m-surface",
      "light": "m-surface-bright"
    },
    "diffLineNumber": {
      "dark": "m-outline",
      "light": "m-outline-bright"
    },
    "diffAddedLineNumberBg": {
      "dark": "m-surface-container",
      "light": "m-surface-container-bright"
    },
    "diffRemovedLineNumberBg": {
      "dark": "m-surface-container",
      "light": "m-surface-container-bright"
    },
    "markdownText": {
      "dark": "m-on-surface",
      "light": "m-on-surface-bright"
    },
    "markdownHeading": {
      "dark": "m-primary",
      "light": "m-primary-bright"
    },
    "markdownLink": {
      "dark": "m-secondary",
      "light": "m-secondary-bright"
    },
    "markdownLinkText": {
      "dark": "m-tertiary",
      "light": "m-tertiary-bright"
    },
    "markdownCode": {
      "dark": "m-secondary-container",
      "light": "m-secondary-container-bright"
    },
    "markdownBlockQuote": {
      "dark": "m-surface-variant",
      "light": "m-surface-variant-bright"
    },
    "markdownEmph": {
      "dark": "m-error-container",
      "light": "m-error-container-bright"
    },
    "markdownStrong": {
      "dark": "m-primary-container",
      "light": "m-primary-container-bright"
    },
    "markdownHorizontalRule": {
      "dark": "m-outline-variant",
      "light": "m-outline-variant-bright"
    },
    "markdownListItem": {
      "dark": "m-primary",
      "light": "m-primary-bright"
    },
    "markdownListEnumeration": {
      "dark": "m-secondary",
      "light": "m-secondary-bright"
    },
    "markdownImage": {
      "dark": "m-tertiary",
      "light": "m-tertiary-bright"
    },
    "markdownImageText": {
      "dark": "m-tertiary-container",
      "light": "m-tertiary-container-bright"
    },
    "markdownCodeBlock": {
      "dark": "m-on-surface",
      "light": "m-on-surface-bright"
    },
    "syntaxComment": {
      "dark": "m-outline",
      "light": "m-outline-bright"
    },
    "syntaxKeyword": {
      "dark": "m-primary",
      "light": "m-primary-bright"
    },
    "syntaxFunction": {
      "dark": "m-tertiary",
      "light": "m-tertiary-bright"
    },
    "syntaxVariable": {
      "dark": "m-secondary",
      "light": "m-secondary-bright"
    },
    "syntaxString": {
      "dark": "m-secondary-container",
      "light": "m-secondary-container-bright"
    },
    "syntaxNumber": {
      "dark": "m-tertiary-container",
      "light": "m-tertiary-container-bright"
    },
    "syntaxType": {
      "dark": "m-primary-container",
      "light": "m-primary-container-bright"
    },
    "syntaxOperator": {
      "dark": "m-on-surface-variant",
      "light": "m-on-surface-variant-bright"
    },
    "syntaxPunctuation": {
      "dark": "m-outline",
      "light": "m-outline-bright"
    },
    "selectedListItemText": {
      "dark": "m-surface",
      "light": "m-surface-bright"
    },
    "backgroundMenu": {
      "dark": "m-surface-container",
      "light": "m-surface-container-bright"
    }
  }
}
