{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "ask",
    "edit": "ask",
    "todowrite": "allow",
    "skill": {
      "*": "allow",
      "pr-review": "allow",
      "internal-*": "deny",
      "experimental-*": "ask"
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "openslimedit@latest"
  ]
}
